#!/bin/sh
# Pre-commit: reject work identifiers in what is about to be committed.
# See specs/cross-platform-plugin-packaging.md.
#
# Runs .githooks/check_no_work_refs.dart against the (git-ignored)
# .work-identifiers term list. Bypass with `git commit --no-verify`.

root="$(git rev-parse --show-toplevel)" || exit 1

if command -v dart >/dev/null 2>&1; then
  dart_bin=dart
elif [ -x "$HOME/dart/bin/dart" ]; then
  dart_bin="$HOME/dart/bin/dart"
else
  echo "check_no_work_refs: no dart on PATH; skipping." >&2
  exit 0
fi

exec "$dart_bin" run "$root/.githooks/check_no_work_refs.dart"
